<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Draw under display cutouts; the game receives the cutout insets as CSS safe-area variables. -->
    <style name="Theme.NeonHorde" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nh_bg</item>
        <item name="android:colorBackground">@color/nh_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
